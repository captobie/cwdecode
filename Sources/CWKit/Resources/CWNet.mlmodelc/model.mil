            tensor<fp32, [1, 50, ?]> x = conv(bias = net_head_3_bias, dilations = x_dilations_0, groups = x_groups_0, pad = x_pad_0, pad_type = x_pad_type_0, strides = x_strides_0, weight = net_head_3_weight, x = input_83)[name = string("x")];
            tensor<int32, [3]> var_248 = const()[name = string("op_248"), val = tensor<int32, [3]>([2, 0, 1])];
            tensor<fp32, [?, 1, 50]> var_249 = transpose(perm = var_248, x = x)[name = string("transpose_1")];
            tensor<fp32, [?, 1, 50]> var_251_softmax = softmax(axis = var_3, x = var_249)[name = string("op_251_softmax")];
            fp32 var_251_epsilon_0 = const()[name = string("op_251_epsilon_0"), val = fp32(0x1p-149)];
            tensor<fp32, [?, 1, 50]> var_251 = log(epsilon = var_251_epsilon_0, x = var_251_softmax)[name = string("op_251")];
            tensor<int32, [3]> var_255 = const()[name = string("op_255"), val = tensor<int32, [3]>([1, 0, 2])];
            tensor<fp32, [1, ?, 50]> log_probs = transpose(perm = var_255, x = var_251)[name = string("transpose_0")];
        } -> (log_probs);
}